local SetLockCam = createToggle(Pages.COMBAT, "LockCam", function(Enabled)
    local Camera = workspace.CurrentCamera
    local _, Humanoid, Root = getCharacter()

    if Enabled then
        local Folder = workspace:FindFirstChild("Targets")
        if not Folder or not Root then
            State.LockCam = false
            return
        end

        local Nearest
        local Distance = math.huge

        for _, Target in ipairs(Folder:GetChildren()) do
            local TargetHumanoid = Target:FindFirstChildOfClass("Humanoid")
            local TargetRoot = Target:FindFirstChild("HumanoidRootPart")

            if TargetHumanoid and TargetRoot and TargetHumanoid.Health > 0 then
                local CurrentDistance = (Root.Position - TargetRoot.Position).Magnitude

                if CurrentDistance < Distance then
                    Distance = CurrentDistance
                    Nearest = TargetHumanoid
                end
            end
        end

        if Nearest then
            OldCamera = Camera.CameraSubject
            Camera.CameraSubject = Nearest
            State.LockCam = true
        else
            SetLockCam(false)
        end
    else
        Camera.CameraSubject = Humanoid or OldCamera
        State.LockCam = false
    end
end)

