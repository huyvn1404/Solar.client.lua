local function createButton(Page, Name)
    local Button = newInstance("TextButton", {
        Size = UDim2.new(1, -8, 0, 42),
        BackgroundColor3 = Color3.fromRGB(75, 45, 105),
        Text = Name,
        TextColor3 = Color3.new(1, 1, 1),
        Font = Enum.Font.GothamBold,
        TextSize = 14
    }, Page)

    newInstance("UICorner", {
        CornerRadius = UDim.new(0, 8)
    }, Button)

    return Button
end

local function createToggle(Page, Name, Callback)
    local Enabled = false
    local Button = createButton(Page, Name .. ": OFF")

    local function Set(value)
        Enabled = value
        Button.Text = Name .. (Enabled and ": ON" or ": OFF")
        Button.BackgroundColor3 = Enabled
            and Color3.fromRGB(145, 90, 190)
            or Color3.fromRGB(75, 45, 105)
    end

    Button.Activated:Connect(function()
        Set(not Enabled)
        Callback(Enabled)
    end)

    return Set
end

local function createInput(Page, Name, Default)
    local Box = newInstance("TextBox", {
        Size = UDim2.new(1, -8, 0, 40),
        BackgroundColor3 = Color3.fromRGB(45, 34, 65),
        TextColor3 = Color3.new(1, 1, 1),
        PlaceholderText = Name,
        Text = tostring(Default),
        ClearTextOnFocus = false,
        Font = Enum.Font.Gotham,
        TextSize = 14
    }, Page)

    newInstance("UICorner", {
        CornerRadius = UDim.new(0, 8)
    }, Box)

    return Box
end

local function updateSetting(Box, Key)
    local Value = tonumber(Box.Text)

    if Value then
        Settings[Key] = math.clamp(Value, 1, 250)
    end

    Box.Text = tostring(Settings[Key])
end

