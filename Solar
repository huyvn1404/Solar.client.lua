local function stopFly()
    State.Fly = false
    Vertical = 0

    if FlyConnection then
        FlyConnection:Disconnect()
        FlyConnection = nil
    end

    local _, Humanoid = getCharacter()

    if Humanoid then
        Humanoid.PlatformStand = false
        Humanoid.AutoRotate = true
        Humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
    end

    FlyUp.Visible = false
    FlyDown.Visible = false
end

local function startFly()
    stopFly()

    local _, Humanoid, Root = getCharacter()
    if not Humanoid or not Root then return end

    State.Fly = true
    Humanoid.AutoRotate = false
    Humanoid.PlatformStand = true
    Humanoid:ChangeState(Enum.HumanoidStateType.Physics)

    FlyUp.Visible = true
    FlyDown.Visible = true

    FlyConnection = RunService.Heartbeat:Connect(function(DeltaTime)
        if not State.Fly or not Root.Parent or Humanoid.Health <= 0 then
            stopFly()
            return
        end

        local Direction = Humanoid.MoveDirection
        local Movement = Direction * Settings.FlySpeed
        local Height = Vector3.new(
            0,
            Vertical * Settings.FlySpeed,
            0
        )

        Root.CFrame = Root.CFrame + (Movement + Height) * DeltaTime
    end)
end

local function holdButton(Button, Value)
    Button.InputBegan:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.Touch
            or Input.UserInputType == Enum.UserInputType.MouseButton1 then
            Vertical = Value
        end
    end)

    Button.InputEnded:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.Touch
            or Input.UserInputType == Enum.UserInputType.MouseButton1 then
            if Vertical == Value then
                Vertical = 0
            end
        end
    end)
end

holdButton(FlyUp, 1)
